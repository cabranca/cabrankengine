EMSDK_ENV = ../tools/emsdk/emsdk_env.sh

# Full engine WASM build: rendering stack via WebGL2 / GLES 3.0, GLFW3 emscripten compat.
# CBKBindings reuses Application::loadScene to drive the live RenderLayer.
#
# Per-file compilation:
#   make -f Makefile.emscripten -jN     parallel build (N = cores)
#   make -f Makefile.emscripten V=1     show full em++ commands
#   make -f Makefile.emscripten clean
# Header changes are tracked via -MMD/-MP, so incremental rebuilds work.

# -----------------------------------------------------------------------------
# Sources
# -----------------------------------------------------------------------------

C_SOURCES = \
    ../Common/vendor/lz4/lz4.c

SOURCES = \
    src/CBKBindings.cpp \
    ../Common/src/Common/Logger.cpp \
    ../Cabrankengine/src/Cabrankengine/Core/Application.cpp \
    ../Cabrankengine/src/Cabrankengine/Core/Layer.cpp \
    ../Cabrankengine/src/Cabrankengine/Core/LayerStack.cpp \
    ../Cabrankengine/src/Cabrankengine/ECS/BuiltInSystems.cpp \
    ../Cabrankengine/src/Cabrankengine/ECS/EntityManager.cpp \
    ../Cabrankengine/src/Cabrankengine/Scene/DefaultLibrary.cpp \
    ../Cabrankengine/src/Cabrankengine/Scene/Mesh.cpp \
    ../Cabrankengine/src/Cabrankengine/Scene/Model.cpp \
    ../Cabrankengine/src/Cabrankengine/Scene/Scene.cpp \
    ../Cabrankengine/src/Cabrankengine/Scene/SceneSerializer.cpp \
    ../Cabrankengine/src/Cabrankengine/Scene/Archetypes/CameraArch.cpp \
    ../Cabrankengine/src/Cabrankengine/Scene/Archetypes/CameraControllerArch.cpp \
    ../Cabrankengine/src/Cabrankengine/Scene/Archetypes/DirectionalLightArch.cpp \
    ../Cabrankengine/src/Cabrankengine/Scene/Archetypes/PBRModelArch.cpp \
    ../Cabrankengine/src/Cabrankengine/Scene/Archetypes/PhongModelArch.cpp \
    ../Cabrankengine/src/Cabrankengine/Scene/Archetypes/PointLightArch.cpp \
    ../Cabrankengine/src/Cabrankengine/Scene/Archetypes/SpriteArch.cpp \
    ../Cabrankengine/src/Cabrankengine/Scene/Archetypes/TextArch.cpp \
    ../Cabrankengine/src/Cabrankengine/Renderer/EditorCamera.cpp \
    ../Cabrankengine/src/Cabrankengine/Renderer/FrameBuffer.cpp \
    ../Cabrankengine/src/Cabrankengine/Renderer/GeometryDescriptor.cpp \
    ../Cabrankengine/src/Cabrankengine/Renderer/GraphicsContext.cpp \
    ../Cabrankengine/src/Cabrankengine/Renderer/RenderCommand.cpp \
    ../Cabrankengine/src/Cabrankengine/Renderer/Renderer.cpp \
    ../Cabrankengine/src/Cabrankengine/Renderer/Renderer2D.cpp \
    ../Cabrankengine/src/Cabrankengine/Renderer/RendererAPI.cpp \
    ../Cabrankengine/src/Cabrankengine/Renderer/RenderLayer.cpp \
    ../Cabrankengine/src/Cabrankengine/Renderer/Shader.cpp \
    ../Cabrankengine/src/Cabrankengine/Renderer/StorageBuffer.cpp \
    ../Cabrankengine/src/Cabrankengine/Renderer/TextRenderer.cpp \
    ../Cabrankengine/src/Cabrankengine/Renderer/Texture.cpp \
    ../Cabrankengine/src/Cabrankengine/Renderer/UniformBuffer.cpp \
    ../Cabrankengine/src/Cabrankengine/Renderer/Materials/PBRMaterial.cpp \
    ../Cabrankengine/src/Cabrankengine/Renderer/Materials/PhongMaterial.cpp \
    ../Cabrankengine/src/Cabrankengine/Renderer/Materials/TextMaterial.cpp \
    ../Cabrankengine/src/Cabrankengine/Renderer/Materials/Texture2DMaterial.cpp \
    ../Cabrankengine/src/Platform/Linux/LinuxInput.cpp \
    ../Cabrankengine/src/Platform/Linux/LinuxWindow.cpp \
    ../Cabrankengine/src/Platform/OpenGL/OpenGLBuffer.cpp \
    ../Cabrankengine/src/Platform/OpenGL/OpenGLContext.cpp \
    ../Cabrankengine/src/Platform/OpenGL/OpenGLFrameBuffer.cpp \
    ../Cabrankengine/src/Platform/OpenGL/OpenGLPBRMaterial.cpp \
    ../Cabrankengine/src/Platform/OpenGL/OpenGLPhongMaterial.cpp \
    ../Cabrankengine/src/Platform/OpenGL/OpenGLRendererAPI.cpp \
    ../Cabrankengine/src/Platform/OpenGL/OpenGLShader.cpp \
    ../Cabrankengine/src/Platform/OpenGL/OpenGLStorageBuffer.cpp \
    ../Cabrankengine/src/Platform/OpenGL/OpenGLTextMaterial.cpp \
    ../Cabrankengine/src/Platform/OpenGL/OpenGLTexture.cpp \
    ../Cabrankengine/src/Platform/OpenGL/OpenGLTexture2DMaterial.cpp \
    ../Cabrankengine/src/Platform/OpenGL/OpenGLUniformBuffer.cpp \
    ../Cabrankengine/src/Platform/OpenGL/OpenGLVertexArray.cpp

INCLUDES = \
    -Iinclude/compat \
    -I../Cabrankengine/src \
    -I../Common/src \
    -I../Common/vendor/lz4 \
    -I../Common/vendor/spdlog/include \
    -I../Cabrankengine/vendor/json/single_include

DEFINES = \
    -DCBK_WASM \
    -DCBK_PLATFORM_LINUX \
    -DCBK_RENDERER_OPENGL \
    -DCBK_OPENGL_ES

# -----------------------------------------------------------------------------
# Flags
# -----------------------------------------------------------------------------

# Compile-time only. -MMD/-MP emits per-source .d files for header tracking.
# -sUSE_FREETYPE is needed here too because that port ships its own headers
# (GLFW/WEBGL2 live in the sysroot — those stay link-only).
EMCC_CXX_COMPILE_FLAGS = \
    -std=c++23 \
    -O2 \
    -fexceptions \
    -MMD -MP \
    -sUSE_FREETYPE=1 \
    $(DEFINES)

EMCC_C_COMPILE_FLAGS = \
    -O2 \
    -fexceptions \
    -MMD -MP \
    $(DEFINES)

# Link-time only. -sASSERTIONS / -sGL_ASSERTIONS are debug-only; drop them
# for production builds.
EMCC_LINK_FLAGS = \
    -O2 \
    -fexceptions \
    --bind \
    -sEXPORT_ES6=1 \
    -sMODULARIZE=1 \
    -sEXPORT_NAME='CabrankEngine' \
    -sALLOW_MEMORY_GROWTH=1 \
    -sUSE_GLFW=3 \
    -sUSE_WEBGL2=1 \
    -sUSE_FREETYPE=1 \
    -sFULL_ES3=1 \
    -sFORCE_FILESYSTEM=1 \
    -sEXPORTED_RUNTIME_METHODS=['FS'] \
    -sASSERTIONS=1 \
    -sGL_ASSERTIONS=1 \
    --embed-file ../config.json@/config.json \
    --embed-file ../Sandbox/assets/shaders@/assets/shaders \
    --embed-file ../Sandbox/assets/fonts@/assets/fonts

# -----------------------------------------------------------------------------
# Output paths and per-source mapping
# -----------------------------------------------------------------------------

OBJ_DIR = bin/wasm/obj
OUT     = bin/wasm/CBKBindings.js

# config.json is created at runtime by cbk::Config::load when missing (and is
# gitignored), so a clean checkout has none. The link step embeds it into the
# WASM bundle, so generate the default here if it is absent. Mirrors the
# defaults in Cabrankengine/src/Cabrankengine/Config/Config.h.
CONFIG_JSON = ../config.json

# Mirror the source tree under OBJ_DIR. Replace `..` with `_` so all objects
# stay inside OBJ_DIR (and basename collisions across source roots are avoided).
cxx_obj = $(OBJ_DIR)/$(subst ../,_/,$(1:.cpp=.o))
c_obj   = $(OBJ_DIR)/$(subst ../,_/,$(1:.c=.o))

CXX_OBJS = $(foreach s,$(SOURCES),$(call cxx_obj,$(s)))
C_OBJS   = $(foreach s,$(C_SOURCES),$(call c_obj,$(s)))
ALL_OBJS = $(CXX_OBJS) $(C_OBJS)
DEPS     = $(ALL_OBJS:.o=.d)

# Verbose mode: `make V=1` shows full em++/emcc commands; default shows a tag.
ifeq ($(V),1)
    Q =
else
    Q = @
endif

# -----------------------------------------------------------------------------
# Targets
# -----------------------------------------------------------------------------

.PHONY: all clean
all: $(OUT)

$(OUT): $(ALL_OBJS) Makefile.emscripten | $(CONFIG_JSON)
	@mkdir -p $(dir $@)
	@echo "  LINK $@"
	$(Q)em++ $(EMCC_LINK_FLAGS) $(ALL_OBJS) -o $@

# Order-only target: only generated when the file does not already exist, so a
# user's existing config.json is never overwritten and does not force a relink.
$(CONFIG_JSON):
	@echo "  GEN  $@"
	@printf '%s\n' \
		'{' \
		'    "window": {' \
		'        "title": "Cabrankengine",' \
		'        "width": 1600,' \
		'        "height": 900' \
		'    }' \
		'}' > $@

# Per-source compile rules generated via eval. Each rule has the source as an
# explicit prerequisite, plus the Makefile so flag changes trigger a rebuild.
define CXX_RULE
$(call cxx_obj,$(1)): $(1) Makefile.emscripten
	@mkdir -p $$(dir $$@)
	@echo "  CXX  $(1)"
	$(Q)em++ $(EMCC_CXX_COMPILE_FLAGS) $(INCLUDES) -c $$< -o $$@
endef
$(foreach src,$(SOURCES),$(eval $(call CXX_RULE,$(src))))

define C_RULE
$(call c_obj,$(1)): $(1) Makefile.emscripten
	@mkdir -p $$(dir $$@)
	@echo "  CC   $(1)"
	$(Q)emcc $(EMCC_C_COMPILE_FLAGS) $(INCLUDES) -c $$< -o $$@
endef
$(foreach src,$(C_SOURCES),$(eval $(call C_RULE,$(src))))

clean:
	rm -rf bin/wasm

-include $(DEPS)
