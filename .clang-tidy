---
# Conservative ruleset for Cabrankengine. Formatting is owned by .clang-format;
# this file covers correctness, performance, and naming only.
#
# Deliberately disabled: checks that fight this codebase's established style
# (brace-less single statements, the Ref/Scope smart-pointer aliases, the
# CBK_* logging and assert macros) or that are pure noise at this scale.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-macro-parentheses,
  -bugprone-branch-clone,
  performance-*,
  -performance-avoid-endl,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  modernize-use-emplace,
  modernize-use-default-member-init,
  modernize-loop-convert,
  modernize-redundant-void-arg,
  readability-const-return-type,
  readability-redundant-member-init,
  readability-redundant-string-cstr,
  readability-static-definition-in-anonymous-namespace,
  readability-identifier-naming

# Only lint our own sources. These are matched against the path as clang-tidy
# prints it, which is relative to the compile-DB "directory" field — so it is
# often 'src/Cabrankengine/...', NOT 'Cabrankengine/src/...'. Anchoring on the
# module name silently matches nothing. Vendor code (notably freetype) also has
# a src/ directory, hence the separate exclude.
HeaderFilterRegex: '(^|/)(src|include)/'
ExcludeHeaderFilterRegex: '/vendor/'

WarningsAsErrors: ''

CheckOptions:
  # --- Types and namespaces ---
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase
  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase

  # --- Functions ---
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.MethodCase
    value: camelBack

  # --- Data members ---
  # m_PascalCase private/protected, s_PascalCase static members.
  #
  # PublicMemberCase is deliberately NOT set. Two conventions coexist and both
  # are correct: ECS components use PascalCase (CTransform::Position), while
  # GPU-facing and on-disk layout structs use camelCase (position, texCoord,
  # magic, width) so the field names line up with the shader source and the
  # .cbkm/.cbkt binary layout. Enforcing either one flags ~120 correct fields.
  - key: readability-identifier-naming.PrivateMemberCase
    value: CamelCase
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: 'm_'
  - key: readability-identifier-naming.ProtectedMemberCase
    value: CamelCase
  - key: readability-identifier-naming.ProtectedMemberPrefix
    value: 'm_'
  - key: readability-identifier-naming.ClassMemberCase
    value: CamelCase
  - key: readability-identifier-naming.ClassMemberPrefix
    value: 's_'

  # --- Statics at file scope ---
  # s_Data, s_SceneUBO, s_GLFWInitialized. GlobalVariable must be set as well as
  # StaticVariable: file-scope state declared inside an anonymous namespace is
  # classified as a global, not a static, and without this rule it falls through
  # to VariableCase and gets its s_ prefix stripped.
  - key: readability-identifier-naming.StaticVariableCase
    value: CamelCase
  - key: readability-identifier-naming.StaticVariablePrefix
    value: 's_'
  - key: readability-identifier-naming.GlobalVariableCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalVariablePrefix
    value: 's_'

  # --- Constants: k_PascalCase at namespace and class scope ---
  # k_Pi, k_MaxQuads, k_MaxEntities, k_MaxFramesInFlight.
  #
  # LocalConstant deliberately gets camelBack and NO k_ prefix. A `const bool
  # hasNormal` inside a function is a local variable that happens to be const,
  # not a named constant; requiring k_ there renames ~60 correct identifiers
  # (dstW, mipLevels, pixelCount) to something worse.
  #
  # ConstexprVariable* is deliberately NOT set: it outranks every other
  # category, so setting it applies the k_ rule to those same locals and
  # drowns the real findings.
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: 'k_'
  - key: readability-identifier-naming.ClassConstantCase
    value: CamelCase
  - key: readability-identifier-naming.ClassConstantPrefix
    value: 'k_'
  - key: readability-identifier-naming.LocalConstantCase
    value: camelBack

  # --- Locals and parameters ---
  - key: readability-identifier-naming.VariableCase
    value: camelBack
  - key: readability-identifier-naming.ParameterCase
    value: camelBack
  - key: readability-identifier-naming.LocalVariableCase
    value: camelBack

  # --- Misc ---
  - key: performance-unnecessary-value-param.AllowedTypes
    value: 'Ref;Scope'
  - key: modernize-use-default-member-init.UseAssignment
    value: 'true'
