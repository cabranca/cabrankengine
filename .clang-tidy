---
# Conservative ruleset for Cabrankengine. Formatting is owned by .clang-format;
# this file covers correctness, performance, and naming only.
#
# Deliberately disabled: checks that fight this codebase's established style
# (brace-less single statements, the Ref/Scope smart-pointer aliases, the
# CBK_* logging and assert macros) or that are pure noise at this scale.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-macro-parentheses,
  -bugprone-branch-clone,
  performance-*,
  -performance-avoid-endl,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  modernize-use-emplace,
  modernize-use-default-member-init,
  modernize-loop-convert,
  modernize-redundant-void-arg,
  readability-const-return-type,
  readability-redundant-member-init,
  readability-redundant-string-cstr,
  readability-static-definition-in-anonymous-namespace,
  readability-identifier-naming

# Only lint our own sources. clang-tidy uses POSIX extended regex here — no
# lookahead — so this relies on vendor code living in <Module>/vendor/ rather
# than under src/, which is already the layout.
HeaderFilterRegex: '(Cabrankengine|Common|Sandbox|UnitTests|CBKAssetConverter|CBKBindings)/(src|include)/'

WarningsAsErrors: ''

CheckOptions:
  # --- Types and namespaces ---
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase
  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase

  # --- Functions ---
  # NOTE: Application::Run() and OnEvent(), and SystemManager::EntityDestroyed()
  # and EntitySignatureChanged(), are legacy PascalCase and will warn here.
  # They are public API — leave them alone (see CLAUDE.md).
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.MethodCase
    value: camelBack

  # --- Data members ---
  # m_PascalCase private/protected, s_PascalCase statics, PascalCase public PODs.
  - key: readability-identifier-naming.PrivateMemberCase
    value: CamelCase
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: 'm_'
  - key: readability-identifier-naming.ProtectedMemberCase
    value: CamelCase
  - key: readability-identifier-naming.ProtectedMemberPrefix
    value: 'm_'
  - key: readability-identifier-naming.PublicMemberCase
    value: CamelCase
  - key: readability-identifier-naming.ClassMemberCase
    value: CamelCase
  - key: readability-identifier-naming.ClassMemberPrefix
    value: 's_'

  # --- Constants ---
  # k_PascalCase is the current convention (k_MaxFramesInFlight). The older
  # SCREAMING_CASE constants in ECS/Common.h (MAX_ENTITIES, MAX_COMPONENTS,
  # INVALID_ENTITY) predate it and will warn — that drift is intentional to
  # surface, not a reason to rename them without discussion.
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: 'k_'
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: 'k_'

  # --- Locals and parameters ---
  - key: readability-identifier-naming.VariableCase
    value: camelBack
  - key: readability-identifier-naming.ParameterCase
    value: camelBack
  - key: readability-identifier-naming.LocalVariableCase
    value: camelBack

  # --- Misc ---
  - key: performance-unnecessary-value-param.AllowedTypes
    value: 'Ref;Scope'
  - key: modernize-use-default-member-init.UseAssignment
    value: 'true'
